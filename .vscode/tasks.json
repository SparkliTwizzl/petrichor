{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "build",
                "${workspaceRoot}/Source/App/App.csproj"
            ]
        },
        {
            "label": "Common.Test",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceRoot}/Test/Common.Test/Common.Test.csproj"
            ]
        },
        {
            "label": "ShortcutScriptGeneration.Test",
            "type": "shell",
            "command": "dotnet",
            "args": [
                "test",
                "${workspaceRoot}/Test/ShortcutScriptGeneration.Test/ShortcutScriptGeneration.Test.csproj"
            ]
        },
        {
            "label": "unit tests",
            "dependsOn": [
                "Common.Test",
                "ShortcutScriptGeneration.Test"
            ]
        },
        {
            "label": "build & unit test",
            "dependsOn": [
                "build",
                "unit tests"
            ]
        },
    ]
}
